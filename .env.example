# SnapStudy AI Environment Variables

# Telegram Bot Token (from @BotFather)
TELEGRAM_TOKEN=your_telegram_bot_token_here
BOT_USERNAME=iiucstudypartnerbot

# OpenRouter / Gemma 4 AI Model
GEMMA_API_KEY=your_openrouter_api_key_here
GEMMA_BASE_URL=https://openrouter.ai/api/v1
GEMMA_MODEL=google/gemma-4-31b-it:free

# Database Configuration (Local: snapstudy.db, Render with persistent disk: /var/data/snapstudy.db)
DATABASE_PATH=snapstudy.db
LOG_LEVEL=INFO
REQUEST_TIMEOUT_SECONDS=60
MAX_IMAGE_SIDE=1280
MAX_DOWNLOAD_MB=10

# Weak topics and practice thresholds
WEAK_MIN_ATTEMPTS=2
WEAK_ACCURACY_THRESHOLD=60

# Study Portal Settings
# Local dev: http://localhost:8000
# Production: https://<service-name>.onrender.com
PORTAL_BASE_URL=http://localhost:8000
PORTAL_SECRET=generate_a_random_32_byte_secret_or_use_render_generateValue
PORTAL_HOST=0.0.0.0
PORTAL_PORT=8000
PORTAL_TOKEN_TTL_SECONDS=86400
PORTAL_SESSION_DAYS=7
